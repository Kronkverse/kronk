#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/release — ship finished work from `shadow` to `main`, leave the rest.
#
# Work lands on `shadow` whenever it merges, finished or not. When it is done
# and checked on shadow, its author marks the PR **ready to ship** (the label,
# or a `/ready to ship` comment). A release takes only those PRs: it starts
# from `main` and cherry-picks each one's squash commit, in the order they
# merged into shadow. Unfinished work stays on shadow for a later release.
#
#   bin/release check           before a cut: everything that could still make
#                               it in, and what each needs from whom (below)
#   bin/release plan            what the next release would take, and what stays
#   bin/release cut 2.0.2       build release/2.0.2 from main and open its PR
#   DRY_RUN=1 bin/release cut 2.0.2   build the branch locally, push nothing
#   bin/release done 2.0.2      after the release PR is merged and deployed:
#                               mark its PRs shipped, and open the PR that
#                               brings the version bump back to shadow
#
# A pick that conflicts only where the conflict is mechanical is resolved,
# not left out: Markdown docs keep both sides (two PRs each adding an entry
# to the top of docs/decisions.md is the usual one), and db/schema.rb's
# `define(version:)` line takes the later version. Any other conflict, or a
# schema conflict beyond that line, leaves the PR out as before. The release
# PR lists each file resolved this way, for a read before merging.
#
# A PR that builds a Kommons proposal links it in its body, ideally on a line
# of its own (`Proposal: <link or id>`). `cut` gathers those into
# config/shipped_proposals.yaml, and the production deploy marks them actioned.
#
# `check` is the pre-cut checklist, so a cut takes all it can and no claimed
# proposal is forgotten. It lists the open PRs into shadow (still being
# worked on), the merged ones not marked ready (check them on shadow, then
# mark them), the ready ones and whether each applies on main alone (and if
# not, which unready PR it probably needs), and every claimed proposal with
# where its work stands: shipping now, merged but unready, in an open PR,
# shipped already but never actioned, or no PR linking it at all. Proposals
# come from the Kommons mirror (KOMMONS_PROPOSALS, default
# /home/shared/proposals.json on the mainframe); without it that part is
# skipped.
#
# Needs `git` (run inside a clone with an `origin` remote) and `gh` (logged in).
# Plain Ruby, no Rails, so it runs anywhere the repo is checked out. See
# CLAUDE.md, "Releasing".

# It talks to people on the command line and in PR bodies, not to members,
# so it is plain English rather than i18n (as bin/lint-korner-docs).
# rubocop:disable I18n/RailsI18n/DecorateString

require 'json'
require 'open3'
require 'date'
require 'time'
require 'tmpdir'

REPO          = 'Kronkverse/kronk'
READY_LABEL   = 'ready to ship'
SHIPPED_LABEL = 'shipped'
VERSION_FILE  = 'lib/kronk/version.rb'
CHANGELOG     = 'CHANGELOG.md'
GUIDE         = 'CLAUDE.md'
PR_LIST_MARK  = 'release-prs'
SHIPPED_PROPOSALS = 'config/shipped_proposals.yaml'
PROPOSAL_URL  = 'https://kronk.info/hub/kommons/p/'
SCHEMA        = 'db/schema.rb'
# A conflicted file's index stages, in merge-file order: ours, base, theirs.
MERGE_STAGES  = [2, 1, 3].freeze
SCHEMA_LINE   = /\AActiveRecord::Schema\[[\d.]+\]\.define\(version: ([\d_]+)\) do\n\z/

def run(*cmd, allow_failure: false)
  out, err, status = Open3.capture3(*cmd)
  abort("#{cmd.join(' ')} failed:\n#{err}#{out}") unless status.success? || allow_failure
  [out, status.success?]
end

def sh(*cmd) = run(*cmd).first

def gh_json(*) = JSON.parse(sh('gh', *))

def say(line = '') = puts(line)

# ── What is ready ────────────────────────────────────────────────────────────

def ready_prs
  gh_json('pr', 'list', '--repo', REPO, '--base', 'shadow', '--state', 'merged',
          '--label', READY_LABEL, '--limit', '200',
          '--json', 'number,title,body,mergedAt,mergeCommit,author')
    .sort_by { |pr| pr['mergedAt'] }
end

# Merged into shadow since main last moved, carrying neither label: still on
# shadow, not part of the next release. Shown so nobody is surprised.
def waiting_prs
  since = Time.parse(sh('git', 'log', '-1', '--format=%cI', 'origin/main').strip).utc.iso8601
  gh_json('pr', 'list', '--repo', REPO, '--base', 'shadow', '--state', 'merged', '--limit', '200',
          '--search', "merged:>#{since} -label:\"#{READY_LABEL}\" -label:#{SHIPPED_LABEL}",
          '--json', 'number,title,body,mergedAt,mergeCommit,author')
    .reject { |pr| pr['title'].start_with?('Back-merge') } # release machinery, not work
    .sort_by { |pr| pr['mergedAt'] }
end

def line_for(pull) = "##{pull['number']} #{pull['title']} (@#{pull.dig('author', 'login')})"

def fetch! = sh('git', 'fetch', '--quiet', 'origin', 'main', 'shadow')

# ── Version, changelog, guide ────────────────────────────────────────────────

def release_name
  File.read(VERSION_FILE)[/RELEASE_NAME\s*=\s*'([^']*)'/, 1].to_s
end

def label_for(version)
  name = release_name
  name.empty? ? version : %(#{version} "#{name}")
end

def bump_version!(version)
  text = File.read(VERSION_FILE)
  abort("No MILESTONE line in #{VERSION_FILE}") unless text.match?(/MILESTONE = '[^']*'/)
  File.write(VERSION_FILE, text.sub(/MILESTONE = '[^']*'/, "MILESTONE = '#{version}'"))
end

def bump_guide!(version)
  text = File.read(GUIDE)
  updated = text.sub(/Production is `[^`]*`/, "Production is `#{label_for(version)}`")
  File.write(GUIDE, updated) if updated != text
end

def changelog_section(version, prs)
  lines = prs.map { |pr| "- #{pr['title']} (##{pr['number']})" }
  <<~MD
    ### [#{label_for(version)}] - #{Time.now.utc.to_date.iso8601}

    #{lines.join("\n")}

  MD
end

def insert_changelog!(section)
  text = File.read(CHANGELOG)
  abort("No '## Kronk' heading in #{CHANGELOG}") unless text.include?("## Kronk\n\n")
  File.write(CHANGELOG, text.sub("## Kronk\n\n", "## Kronk\n\n#{section}"))
end

def extract_changelog_section(text, version)
  start = text.index("### [#{version}")
  return nil unless start

  stop = text.index(/^### \[/, start + 1) || text.length
  text[start...stop]
end

# ── Proposals ────────────────────────────────────────────────────────────────

# The proposals a set of PRs finishes: every link to a proposal anywhere in a
# PR body, and the bare ids on a `Proposal:` line. Only the line used to
# count, and PRs that named their proposal in a sentence shipped without it
# being actioned (2.1.4). A PR that is one of several for a proposal writes
# `Part of proposal:` on all but the last; links on that line don't count.
PROPOSAL_LINK = %r{kronk\.info/hub/kommons/p/(\d{6,})}

def proposal_ids(prs)
  prs.flat_map do |pr|
    pr['body'].to_s.lines.grep_v(/^\s*Part of proposal:/i).flat_map do |line|
      line.match?(/^Proposal:/i) ? line.scan(/\d{6,}/) : line.scan(PROPOSAL_LINK).flatten
    end
  end.uniq
end

def record_proposals!(version, ids)
  return if ids.empty?

  File.write(SHIPPED_PROPOSALS, "#{File.read(SHIPPED_PROPOSALS).rstrip}\n\n'#{version}':\n#{ids.map { |id| "  - '#{id}'" }.join("\n")}\n")
end

# ── plan ─────────────────────────────────────────────────────────────────────

def plan
  fetch!
  ready = ready_prs
  say "Ready to ship (#{ready.size}) — the next release would take these, oldest first:"
  ready.empty? ? say('  (none — mark finished PRs with the "ready to ship" label)') : ready.each { |pr| say "  #{line_for(pr)}" }
  say
  waiting = waiting_prs
  say "Merged into shadow, not marked ready (#{waiting.size}) — these stay on shadow:"
  waiting.empty? ? say('  (none)') : waiting.each { |pr| say "  #{line_for(pr)}" }
end

# ── check ────────────────────────────────────────────────────────────────────

PROPOSALS_JSON = ENV.fetch('KOMMONS_PROPOSALS', '/home/shared/proposals.json')
STALE_DAYS = 7

def open_prs
  gh_json('pr', 'list', '--repo', REPO, '--base', 'shadow', '--state', 'open', '--limit', '200',
          '--json', 'number,title,body,author,isDraft,updatedAt,statusCheckRollup,autoMergeRequest')
    .sort_by { |pr| pr['number'] }
end

def ci_state(pull)
  checks = pull['statusCheckRollup'].to_a
  results = checks.map { |c| (c['conclusion'] || c['state']).to_s.upcase }
  return 'CI failing' if results.intersect?(%w(FAILURE ERROR CANCELLED TIMED_OUT ACTION_REQUIRED))
  return 'CI running' if results.include?('PENDING') || checks.any? { |c| c['status'] && c['status'] != 'COMPLETED' }

  checks.empty? ? 'no CI yet' : 'CI green'
end

def days_since(iso) = ((Time.now.utc - Time.parse(iso).utc) / 86_400).floor

# The proposals a PR finishes, and those it is only part of.
def proposal_links(pull)
  finishes = proposal_ids([pull])
  part = pull['body'].to_s.lines.grep(/^\s*Part of proposal:/i).flat_map { |line| line.scan(/\d{6,}/) }
  [finishes, part - finishes]
end

def files_of(sha) = sh('git', 'diff-tree', '--no-commit-id', '--name-only', '-r', sha).split("\n")

# What `cut` would do with each ready PR, without touching the checkout:
# replay the picks onto main with `git merge-tree`. :clean, :mechanical (a
# docs or schema-stamp conflict `cut` resolves) or :blocked, with the files.
def simulate_picks(ready)
  head = sh('git', 'rev-parse', 'origin/main').strip
  ready.map do |pr|
    sha = pr.dig('mergeCommit', 'oid')
    out, = run('git', 'merge-tree', '--write-tree', '--name-only', '--no-messages', "--merge-base=#{sha}^", head, sha, allow_failure: true)
    tree, *conflicted = out.split("\n").reject(&:empty?)
    next pr.merge('pick' => :blocked, 'files' => ['(could not replay)']) unless tree.to_s.match?(/\A\h{40}\z/)

    outcome = if conflicted.empty?
                :clean
              elsif conflicted.all? { |path| path == SCHEMA || union_doc?(path) }
                :mechanical
              else
                :blocked
              end
    head = sh('git', 'commit-tree', tree, '-p', head, '-m', "pick ##{pr['number']}").strip unless outcome == :blocked
    pr.merge('pick' => outcome, 'files' => conflicted)
  end
end

def say_section(title, items, empty: '(none)', hint: nil)
  say "#{title} (#{items.size})"
  say "  → #{hint}" if hint && !items.empty?
  items.empty? ? say("  #{empty}") : items.each { |line| say "  #{line}" }
  say
end

def proposal_note(pull, titles)
  finishes, part = proposal_links(pull)
  notes = finishes.map { |id| "proposal “#{titles.fetch(id, id)}”" } + part.map { |id| "part of “#{titles.fetch(id, id)}”" }
  notes.empty? ? '' : " — #{notes.join(', ')}"
end

def check
  fetch!
  proposals = File.exist?(PROPOSALS_JSON) ? JSON.parse(File.read(PROPOSALS_JSON)) : nil
  titles = proposals.to_a.to_h { |p| [p['id'], p['title']] }
  todo = []

  say "Before cutting — #{Time.now.utc.strftime('%Y-%m-%d %H:%M')} UTC, production is #{File.read(GUIDE)[/Production is `([^`]*)`/, 1] || '?'}"
  say

  # 1. Still being worked on.
  opened = open_prs
  say_section('1. Open PRs into shadow — still being worked on', opened.map do |pr|
    state = [pr['isDraft'] ? 'draft' : nil, ci_state(pr), pr['autoMergeRequest'] ? 'queued' : nil,
             (d = days_since(pr['updatedAt'])) >= STALE_DAYS ? "untouched #{d} days" : nil].compact.join(', ')
    "#{line_for(pr)} [#{state}]#{proposal_note(pr, titles)}"
  end, hint: 'finish and merge these to get them in (then check and mark them), or leave them for the next cut')
  todo << "finish or defer #{opened.size} open PR(s)" unless opened.empty?

  # 2. Merged but not marked.
  waiting = waiting_prs
  say_section('2. Merged into shadow, not marked ready — check each on shadow', waiting.map do |pr|
    "#{line_for(pr)}#{proposal_note(pr, titles)}"
  end, hint: 'if it works on shadow and is finished, comment `/ready to ship` on it; if not, say what is left')
  todo << "check #{waiting.size} merged PR(s) on shadow and mark the finished ones ready" unless waiting.empty?

  # 3. Ready, and whether each would go in.
  ready = simulate_picks(ready_prs)
  waiting_files = waiting.to_h { |pr| [pr['number'], files_of(pr.dig('mergeCommit', 'oid'))] }
  say_section('3. Marked ready to ship — the cut takes these', ready.map do |pr|
    case pr['pick']
    when :clean then "#{line_for(pr)} — applies on main#{proposal_note(pr, titles)}"
    when :mechanical then "#{line_for(pr)} — applies; cut resolves #{pr['files'].join(', ')} (read them in the release PR)#{proposal_note(pr, titles)}"
    else
      needs = waiting.select { |w| w['mergedAt'] < pr['mergedAt'] && waiting_files[w['number']].intersect?(pr['files']) }
      needs_note = needs.empty? ? '' : "; probably needs #{needs.map { |w| "##{w['number']}" }.join(', ')} marked ready too"
      "#{line_for(pr)} — WON'T APPLY alone: conflicts in #{pr['files'].join(', ')}#{needs_note}"
    end
  end, empty: '(none — nothing to cut yet)')
  blocked = ready.count { |pr| pr['pick'] == :blocked }
  todo << "unblock #{blocked} ready PR(s) that won't apply alone" if blocked.positive?

  # 4. Claimed proposals, and where their work is.
  if proposals.nil?
    say "4. Claimed proposals — skipped: no #{PROPOSALS_JSON} (set KOMMONS_PROPOSALS to the Kommons mirror's proposals.json)"
    say
  else
    stages = Hash.new { |h, k| h[k] = [] }
    { 'ready' => ready, 'merged, not ready' => waiting, 'open PR' => opened }.each do |stage, prs|
      prs.each do |pr|
        finishes, part = proposal_links(pr)
        finishes.each { |id| stages[id] << [stage, pr, false] }
        part.each { |id| stages[id] << [stage, pr, true] }
      end
    end

    claimed = proposals.select { |p| p['status'] == 'claimed' }
    groups = Hash.new { |h, k| h[k] = [] }
    claimed.each do |p|
      line = "“#{p['title']}” (@#{p['claimed_by']}) #{p['url']}"
      last = p['comments'].to_a.max_by { |c| c['created_at'] }
      line += " — last comment from @#{last['author']} #{last['created_at'][0, 10]}, reply?" if last && last['author'].casecmp?(p['claimed_by'].to_s) == false
      found = stages[p['id']]
      if found.empty?
        earlier = gh_json('pr', 'list', '--repo', REPO, '--state', 'merged', '--search', p['id'], '--json', 'number,title,author,labels')
        shipped = earlier.select { |pr| pr['labels'].any? { |l| l['name'] == SHIPPED_LABEL } }
        if !shipped.empty?
          groups[:shipped] << "#{line} — shipped in #{shipped.map { |pr| "##{pr['number']}" }.join(', ')}"
        elsif !earlier.empty?
          groups[:old] << "#{line} — merged long ago in #{earlier.map { |pr| "##{pr['number']}" }.join(', ')}, never marked ready"
        else
          groups[:none] << line
        end
      else
        where = found.map { |stage, pr, part| "##{pr['number']} #{stage}#{' (part)' if part}" }.join(', ')
        key = if found.any? { |stage, _, part| stage == 'ready' && !part }
                :shipping
              elsif found.any? { |stage, _, _| stage == 'merged, not ready' }
                :waiting
              else
                :open
              end
        groups[key] << "#{line} — #{where}"
      end
    end
    # Ready or merged work naming a proposal that isn't claimed (open, or
    # already closed or actioned): worth a look before it is actioned again.
    unclaimed = stages.keys.reject { |id| claimed.any? { |p| p['id'] == id } }.map do |id|
      p = proposals.find { |x| x['id'] == id }
      "“#{p ? p['title'] : id}” is #{p ? p['status'] : 'not on the board'} — linked from #{stages[id].map { |_, pr, _| "##{pr['number']}" }.uniq.join(', ')}"
    end

    say "4. Claimed proposals (#{claimed.size})"
    say
    say_section('  a. Shipping in this cut — the deploy marks them actioned', groups[:shipping])
    say_section('  b. Work merged, not marked ready — mark it to get them in', groups[:waiting])
    say_section('  c. Work in an open PR', groups[:open])
    say_section('  d. Work shipped, still claimed — if it is finished, mark it actioned on the Kommons', groups[:shipped])
    say_section('  e. Merged long ago, never marked ready — check and mark', groups[:old])
    say_section('  f. No PR links them — not started, or a PR forgot its `Proposal:` line', groups[:none],
                hint: 'start it, unclaim it, or add `Proposal: <link>` to the PR that built it')
    say_section('  Linked from work in flight but not claimed', unclaimed) unless unclaimed.empty?
    todo << "mark #{groups[:shipped].size} shipped proposal(s) actioned by hand, if finished" unless groups[:shipped].empty?
    todo << "sort out #{groups[:none].size} claimed proposal(s) no PR links" unless groups[:none].empty?
  end

  say 'To do before cutting'
  todo.empty? ? say('  nothing — `bin/release cut <version>`') : todo.each { |item| say "  - #{item}" }
end

# ── cut ──────────────────────────────────────────────────────────────────────

# Docs whose conflicts are kept both ways: two PRs adding their own lines.
def union_doc?(path) = path == GUIDE || (path.start_with?('docs/') && path.end_with?('.md'))

# Each conflict hunk in db/schema.rb, if every one is only the version line,
# takes the later version. False (file untouched) otherwise.
def resolve_schema_stamp!
  text = File.read(SCHEMA)
  mechanical = true
  resolved = text.gsub(/^<<<<<<< [^\n]*\n(.*?)^=======\n(.*?)^>>>>>>> [^\n]*\n/m) do
    ours = Regexp.last_match(1)
    theirs = Regexp.last_match(2)
    a = ours[SCHEMA_LINE, 1]
    b = theirs[SCHEMA_LINE, 1]
    mechanical &&= a && b
    next '' unless a && b

    a.delete('_') >= b.delete('_') ? ours : theirs
  end
  return false unless mechanical

  File.write(SCHEMA, resolved)
  true
end

# Resolve a stopped cherry-pick whose conflicts are all mechanical (see the
# header) and finish it. Returns the files resolved, or nil to leave it.
def resolve_mechanical(conflicted)
  return nil if conflicted.empty?
  return nil unless conflicted.all? { |path| path == SCHEMA || union_doc?(path) }

  conflicted.each do |path|
    if path == SCHEMA
      return nil unless resolve_schema_stamp!
    else
      stages = MERGE_STAGES.map { |n| run('git', 'show', ":#{n}:#{path}", allow_failure: true) }
      return nil unless stages.all? { |(_, ok)| ok }

      files = stages.each_with_index.map do |(content, _), i|
        "#{Dir.tmpdir}/release-#{Process.pid}-#{i}".tap { |f| File.write(f, content) }
      end
      merged, = run('git', 'merge-file', '--union', '-p', *files, allow_failure: true)
      files.each { |f| File.delete(f) }
      File.write(path, merged)
    end
    sh('git', 'add', path)
  end
  _, status = Open3.capture2e({ 'GIT_EDITOR' => 'true' }, 'git', 'cherry-pick', '--continue')
  status.success? ? conflicted : nil
end

def cut(version)
  abort('Usage: bin/release cut <version>, e.g. 2.0.2') unless version&.match?(/\A\d+\.\d+\.\d+\z/)
  abort('Commit or stash your changes first.') unless sh('git', 'status', '--porcelain').strip.empty?

  fetch!
  ready = ready_prs
  abort('Nothing is marked ready to ship.') if ready.empty?

  branch = "release/#{version}"
  sh('git', 'switch', '--quiet', '-C', branch, 'origin/main')

  taken = []
  blocked = []
  ready.each do |pr|
    sha = pr.dig('mergeCommit', 'oid')
    _, ok = run('git', 'cherry-pick', '-x', sha, allow_failure: true)
    if ok
      taken << pr
    else
      conflicted = sh('git', 'diff', '--name-only', '--diff-filter=U').split("\n")
      if (resolved = resolve_mechanical(conflicted))
        taken << pr.merge('resolved' => resolved)
      else
        run('git', 'cherry-pick', '--abort', allow_failure: true)
        blocked << pr.merge('conflicts' => conflicted)
      end
    end
  end
  abort("None of the ready PRs apply cleanly on main:\n#{blocked.map { |pr| "  #{line_for(pr)}" }.join("\n")}") if taken.empty?

  bump_version!(version)
  bump_guide!(version)
  insert_changelog!(changelog_section(version, taken))
  proposals = proposal_ids(taken)
  record_proposals!(version, proposals)
  sh('git', 'add', VERSION_FILE, GUIDE, CHANGELOG, SHIPPED_PROPOSALS)
  sh('git', 'commit', '--quiet', '--no-verify', '-m', "#{version}\n\nRelease bump: version, guide, changelog, shipped proposals.")

  if ENV['DRY_RUN']
    say "DRY RUN: built #{branch} locally; nothing pushed, no PR opened.\n\n#{release_body(version, taken, blocked, waiting_prs, proposals)}"
    return
  end

  sh('git', 'push', '--quiet', '--force-with-lease', '-u', 'origin', branch)

  # Cutting the same version again (more PRs marked ready since) rebuilds the
  # branch; the release PR is already open, so update its body instead.
  body = release_body(version, taken, blocked, waiting_prs, proposals)
  existing = gh_json('pr', 'list', '--repo', REPO, '--base', 'main', '--head', branch, '--state', 'open', '--json', 'url').first
  url = if existing
          sh('gh', 'pr', 'edit', existing['url'], '--repo', REPO, '--title', version, '--body', body)
          existing['url']
        else
          sh('gh', 'pr', 'create', '--repo', REPO, '--base', 'main', '--head', branch, '--title', version, '--body', body).strip
        end

  say "Release PR: #{url}"
  say "Took #{taken.size}: #{taken.map { |pr| "##{pr['number']}" }.join(', ')}"
  say "Could not apply alone (#{blocked.size}): #{blocked.map { |pr| "##{pr['number']}" }.join(', ')}" unless blocked.empty?
  say "Next: edit the changelog wording in the PR if it needs it; the maintainer merges, deploys, then runs `bin/release done #{version}`."
end

def release_body(version, taken, blocked, waiting, proposals)
  parts = []
  parts << "## What changed\n\nRelease **#{label_for(version)}**: the PRs marked *ready to ship*, cherry-picked onto `main` in the order they merged into `shadow`, plus the version bump and changelog.\n"
  parts << "### Shipping (#{taken.size})\n\n#{taken.map { |pr| "- #{line_for(pr)}" }.join("\n")}\n"
  resolved = taken.select { |pr| pr['resolved'] }
  unless resolved.empty?
    parts << "### Resolved automatically (#{resolved.size})\n\nThese conflicted only in docs (both sides kept) or the schema's version line (the later one kept). Read the docs listed before merging.\n\n" \
             "#{resolved.map { |pr| "- #{line_for(pr)} — #{pr['resolved'].join(', ')}" }.join("\n")}\n"
  end
  unless blocked.empty?
    parts << "### Marked ready but could not apply on their own (#{blocked.size})\n\nThese build on work that is not ready yet. They stay on shadow; ship what they depend on first, or ship them together.\n\n" \
             "#{blocked.map { |pr| "- #{line_for(pr)} — conflicts in #{pr['conflicts'].join(', ')}" }.join("\n")}\n"
  end
  parts << "### Staying on shadow (#{waiting.size})\n\nMerged, but not marked ready to ship.\n\n#{waiting.empty? ? '- (none)' : waiting.map { |pr| "- #{line_for(pr)}" }.join("\n")}\n"
  parts << "### Proposals marked actioned by the deploy (#{proposals.size})\n\nFrom the proposal links in the PRs above, written to `#{SHIPPED_PROPOSALS}`. Each proposer is asked to close theirs once production is deployed. Edit that file in this PR to add or drop one.\n\n" \
           "#{proposals.empty? ? '- (none)' : proposals.map { |id| "- #{PROPOSAL_URL}#{id}" }.join("\n")}\n"
  parts << "## Why\n\nShip the finished work without taking unfinished work with it.\n"
  parts << "## How to test\n\nThis tree is `main` plus the PRs above, so it is not exactly what shadow ran: CI on this PR is the check. For a final look, put this PR on shadow with the **Staging Deploy** action.\n"
  parts << "## Dependencies\n\nMaintainer merges, then deploys production (`~/deploy-production.sh`, after checking the range), then runs `bin/release done #{version}`.\n"
  parts << "<!-- #{PR_LIST_MARK}: #{taken.map { |pr| pr['number'] }.join(',')} -->\n\n🤖 Generated with `bin/release`" # rubocop:disable Rails/Pluck -- plain Ruby, no ActiveSupport
  parts.join("\n")
end

# ── done ─────────────────────────────────────────────────────────────────────

def done(version)
  abort('Usage: bin/release done <version>') unless version
  abort('Commit or stash your changes first.') unless sh('git', 'status', '--porcelain').strip.empty?

  release = gh_json('pr', 'list', '--repo', REPO, '--base', 'main', '--state', 'merged',
                    '--search', "#{version} in:title", '--json', 'number,title,body').find { |pr| pr['title'] == version }
  abort("No merged release PR titled #{version} into main.") unless release

  numbers = release['body'][/#{PR_LIST_MARK}: ([\d,]*)/o, 1].to_s.split(',')
  numbers.each do |number|
    sh('gh', 'pr', 'edit', number, '--repo', REPO, '--remove-label', READY_LABEL, '--add-label', SHIPPED_LABEL)
    sh('gh', 'pr', 'comment', number, '--repo', REPO, '--body', "Shipped in #{version} (##{release['number']}).")
  end
  say "Marked shipped: #{numbers.map { |n| "##{n}" }.join(', ')}"

  # Bring the bump back to shadow. Not a merge of main: shadow already has every
  # shipped change, and copying main's files would revert shadow's unreleased
  # edits. Re-apply just the version, the guide line and the changelog section.
  fetch!
  section = extract_changelog_section(sh('git', 'show', "origin/main:#{CHANGELOG}"), version)
  abort("No #{version} section in main's #{CHANGELOG}.") unless section

  branch = "backmerge/#{version}"
  sh('git', 'switch', '--quiet', '-C', branch, 'origin/shadow')
  bump_version!(version)
  bump_guide!(version)
  insert_changelog!(section) unless File.read(CHANGELOG).include?("### [#{version}")
  # Only releases write the shipped-proposals list, so main's copy is the
  # whole truth and can be taken as it is.
  shipped, on_main = run('git', 'show', "origin/main:#{SHIPPED_PROPOSALS}", allow_failure: true)
  File.write(SHIPPED_PROPOSALS, shipped) if on_main
  sh('git', 'add', VERSION_FILE, GUIDE, CHANGELOG, SHIPPED_PROPOSALS)
  sh('git', 'commit', '--quiet', '--no-verify', '-m', "Back-merge #{version}\n\nThe release bump (version, guide line, changelog, shipped proposals) onto shadow.")
  sh('git', 'push', '--quiet', '--force-with-lease', '-u', 'origin', branch)
  url = sh('gh', 'pr', 'create', '--repo', REPO, '--base', 'shadow', '--head', branch, '--title', "Back-merge #{version}",
           '--body', "## What changed\n\nThe #{version} release bump on `shadow`: `MILESTONE`, the guide's \"Production is\" line, and the changelog section.\n\n" \
                     "## Why\n\nSo shadow reports the released version and keeps the changelog.\n\n## How to test\n\n`git diff origin/main -- #{VERSION_FILE}` is empty.\n\n" \
                     "## Dependencies\n\n##{release['number']} merged and deployed.\n\n🤖 Generated with `bin/release`").strip
  say "Back-merge PR: #{url}"
end

case ARGV[0]
when 'check' then check
when 'plan' then plan
when 'cut' then cut(ARGV[1])
when 'done' then done(ARGV[1])
else
  abort(File.read(__FILE__)[%r{^# bin/release.*?^\n}m].gsub(/^# ?/, ''))
end
