-# locals: (title:, subtitle: nil)
-#
-# The title under the seal, centred on the void. Typographic on purpose:
-# the display serif is the identity, so it needs no illustration (the 56px
-# Mastodon artwork this once carried was a bright cartoon register that
-# fought the calm, editorial look).
%table.email-w-full{ cellspacing: 0, cellpadding: 0, border: 0, role: 'presentation' }
  %tr
    %td.email-hero-title-td
      %h1= title
      - if subtitle
        %p= subtitle
