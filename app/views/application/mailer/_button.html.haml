-# A Kronk CTA says what it does; it doesn't need an arrow to point at it.
-# (`has_arrow` is still accepted from older callers and ignored.)
%table.email-btn-table{ cellspacing: 0, cellpadding: 0, border: 0, role: 'presentation' }
  %tr
    %td.email-btn-td
      = link_to text, url, class: 'email-btn-a email-btn-hover'
