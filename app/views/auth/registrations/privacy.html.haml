- content_for :page_title do
  = t('auth.register')

- content_for :header_tags do
  = render partial: 'shared/og', locals: { description: description_for_sign_up(@invite) }

.simple_form
  = render 'auth/shared/progress', stage: 'privacy'

  %h1.title= t('auth.privacy.title')
  %p.lead= t('auth.privacy.preamble', privacy_policy_link: link_to(t('auth.privacy.link_full'), privacy_policy_path, target: '_blank', rel: 'noopener')).html_safe

  %ol.rules-list
    %li
      %button{ type: 'button', aria: { expanded: 'false' } }
        .rules-list__text= t('auth.privacy.point_store_title')
        .rules-list__hint= t('auth.privacy.point_store_body')
    %li
      %button{ type: 'button', aria: { expanded: 'false' } }
        .rules-list__text= t('auth.privacy.point_who_title')
        .rules-list__hint= t('auth.privacy.point_who_body')
    %li
      %button{ type: 'button', aria: { expanded: 'false' } }
        .rules-list__text= t('auth.privacy.point_delete_title')
        .rules-list__hint= t('auth.privacy.point_delete_body')
    %li
      %button{ type: 'button', aria: { expanded: 'false' } }
        .rules-list__text= t('auth.privacy.point_federation_title')
        .rules-list__hint= t('auth.privacy.point_federation_body')

  .stacked-actions
    - next_path = @invite_code.present? ? public_invite_url(invite_code: @invite_code, privacy_accepted: @privacy_token) : new_user_registration_path(privacy_accepted: @privacy_token)
    = link_to t('auth.privacy.cta_next'), next_path, class: 'button'
    -# Back → clears the sticky `rules_accepted` flag so
    -# `require_rules_acceptance!` re-renders the rules step.
    - back_path = @invite_code.present? ? public_invite_url(invite_code: @invite_code, rewind: 'rules') : new_user_registration_path(rewind: 'rules')
    = link_to t('auth.privacy.cta_back'), back_path, class: 'button button-tertiary'
