- content_for :page_title do
  = t('auth.captcha_confirmation.title')

-# In the shell every other Devise view uses (auth/shared/_kronk_auth_form).
= render 'auth/shared/kronk_auth_form',
         footer_links: false,
         lede: t('auth.captcha_confirmation.hint_html'),
         title: t('auth.captcha_confirmation.title') do
  = form_with url: auth_captcha_confirmation_url, class: :simple_form do |form|
    = render 'auth/shared/progress', stage: 'confirm'

    = form.hidden_field :confirmation_token,
                        value: params[:confirmation_token]
    = form.hidden_field :redirect_to_app,
                        value: params[:redirect_to_app]

    = render_captcha

    %p.hint= t('auth.captcha_confirmation.help_html', email: mail_to(Setting.site_contact_email))

    .actions
      = form.button t('challenge.confirm'),
                    type: :submit
