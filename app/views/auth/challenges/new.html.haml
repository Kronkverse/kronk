- content_for :page_title do
  = t('challenge.prompt')

-# In the shell every other Devise view uses (auth/shared/_kronk_auth_form).
= render 'auth/shared/kronk_auth_form', title: t('challenge.prompt') do
  = simple_form_for @challenge, url: request.get? ? auth_challenge_path : '' do |f|
    = f.input :return_to, as: :hidden

    .fields-group
      = f.input :current_password,
                input_html: { autocomplete: 'current-password', autofocus: true },
                label: t('simple_form.labels.defaults.current_password'),
                required: true,
                wrapper: :with_label

    .actions
      = f.button :button, t('challenge.confirm'), type: :submit

    %p.hint.subtle-hint= t('challenge.hint_html')
