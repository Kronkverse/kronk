-# Shared sign-in body — the "wordmark + tagline + email/password
-# form" content used by both entry points to sign in:
-#   * `/` (home#landing) — the ambient signed-out landing.
-#   * `/auth/sign_in` (auth/sessions#new) — Devise's sign-in view,
-#     where a failed login / expired session / explicit link punts
-#     you.
-# One partial for both keeps the visual identical across the two
-# URLs (Tal, 2026-08-06: "keep it simple, unify"). Renders inside
-# the canonical `_kronk_auth_form` shell — that shell owns the
-# hero wordmark, header/footer chrome, and tail links.
-#
-# Locals:
-#   prefill_email: (optional) value to prefill the email field with.
-#                  sessions#new passes `params.dig(:user, :email)`
-#                  after a failed login so the user doesn't have to
-#                  retype it. Landing renders it blank.
-#   switcher_roster: (optional) accounts already authenticated on
-#                    this browser, from `AccountSwitching#switcher_roster`
-#                    (populated by home#index and Auth::SessionsController#new
-#                    via `@switcher_roster`). Rendered above the
-#                    credentials form as tap-to-switch chips when
-#                    non-empty; defaults to [] so first-time /
-#                    signed-out visitors see the form unchanged.

:ruby
  prefill_email   = local_assigns[:prefill_email]
  switcher_roster = local_assigns.fetch(:switcher_roster, [])

= render 'auth/shared/kronk_auth_form',
         lede: t('kronk.landing.tagline') do
  -# Any accounts already authenticated on this browser are offered
  -# above the credentials form as one-tap alternatives.
  = render 'auth/shared/switcher_roster', roster: switcher_roster

  -# `simple_form_for` with a symbol scope means no model object —
  -# `as:` is required on each field or they all default to text.
  -# Devise's session controller only cares about
  -# `params[:user][:email]` and `params[:user][:password]`.
  = simple_form_for(:user, url: user_session_path) do |f|
    .fields-group
      = f.input :email,
                as: :email,
                autofocus: true,
                hint: false,
                input_html: { 'aria-label': t('simple_form.labels.defaults.email'), autocomplete: 'email', value: prefill_email },
                label: t('simple_form.labels.defaults.email'),
                wrapper: :with_label

    .fields-group
      = f.input :password,
                as: :password,
                hint: false,
                input_html: { 'aria-label': t('simple_form.labels.defaults.password'), autocomplete: 'current-password' },
                label: t('simple_form.labels.defaults.password'),
                wrapper: :with_label

    .actions
      = f.button :button, t('auth.login'), type: :submit

  -# Sites this instance trusts to sign people in (OmniAuth: OpenID
  -# Connect, CAS, SAML), e.g. shadow's "Kronk" button, which signs
  -# in with a kronk.info account. Nothing renders when none are
  -# configured, which is production's case. A real POST form, since
  -# OmniAuth refuses GET requests.
  - if User.omniauth_providers.any?
    .alternative-login
      %h4= t('auth.or_log_in_with')

      .actions
        - User.omniauth_providers.each do |provider|
          -# Adding another account (the switcher's /auth/sign_in?add=1)
          -# carries `add` in the query string, the only part OmniAuth hands
          -# back to the callback, so the returning account is added rather
          -# than linked to the one already signed in.
          = button_to provider_sign_in_label(provider), omniauth_authorize_path(:user, provider, **(user_signed_in? && params[:add].present? ? { add: 1 } : {})), class: "button button-secondary button-#{provider}", data: { turbo: false }
