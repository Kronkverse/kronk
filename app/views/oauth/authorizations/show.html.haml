= render 'auth/shared/kronk_auth_form',
         footer_links: false,
         title: t('doorkeeper.authorizations.show.title') do
  .simple_form
    .input-copy
      .input-copy__wrapper
        = copyable_input value: params[:code], class: 'oauth-code'
      %button.button{ type: :button }= t('generic.copy')
