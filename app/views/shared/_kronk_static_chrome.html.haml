-# Static chrome for Rails-served pages. Mirrors what the React KronkFrame
-# renders on SPA routes: top-band grid (wordmark + hub-switcher, the same
-# five pillars), the phone tab bar, fixed right-band (korner sidebar),
-# fixed Ж menu. No Invite button: there is no Invite anywhere
-# (docs/design.md 4.3). Icons resolve from
-# `config/korners/<slug>.yaml → icon.material`, the same source the SPA reads.

:ruby
  korners =
    begin
      Kronk::KornerRegistry.all.select(&:enforced)
    rescue
      []
    end
  hub_switcher_icons =
    begin
      %w(profile feed hub nudges).each_with_object({}) do |slug, memo|
        manifest = Kronk::KornerRegistry.find(slug)
        material = manifest&.icon&.dig('material')
        memo[slug] = material if material.present?
      end
    rescue
      {}
    end
  current_slug = params[:slug] || request.path[%r{^/hub/([a-z0-9-]+)}, 1]
  path = request.path
  # The app's five pillars (features/ui/components/hub_switcher.tsx), in
  # its order. "Me" is the radial hub at /me, and stays lit on a profile;
  # it shows the viewer's avatar, as the app does.
  pillars =
    if user_signed_in?
      [
        { label: 'Me', href: '/me', icon: hub_switcher_icons['profile'], avatar: current_account&.avatar_static_url,
          active: path == '/me' || path.start_with?('/@') },
        { label: 'Home', href: '/home', icon: hub_switcher_icons['feed'], active: path == '/home' || path.start_with?('/home/') },
        { label: 'Always was, always will be', href: '/awawb', icon: 'aboriginal_flag', active: path == '/awawb' },
        { label: 'Hub', href: '/hub', icon: hub_switcher_icons['hub'], active: path.start_with?('/hub') },
        { label: 'Nudges', href: '/nudges', icon: hub_switcher_icons['nudges'], active: path.start_with?('/nudges') },
      ]
    else
      []
    end

-# Ambient Kosmos backdrop — pure-CSS static parity with the SPA's
-# React <KronkKosmos>. Rendered first so it sits behind every other
-# chrome slot (fixed inset:0, z:0). SPA routes get the real canvas
-# via features/ui/index.jsx; Rails-served pages get this static
-# layer. See docs/spaces/kronk.md § Open.
= render 'shared/kronk_kosmos_static'

-# Signed-out visitors get a clean top-band: just the wordmark,
-# centered. The HubSwitcher is Kronk's primary nav for signed-in
-# members — Home/Hub have no useful behaviour for a stranger (they
-# either bounce to /about or the login page), and Me/Nudges are
-# signed-in-only. Rather than render dead pillars, hide the whole
-# switcher. CSS in `_kronk_frame.scss` uses `:has(.hub-switcher)`
-# to swap the top-band grid to center-align the wordmark.
%header.kronk-frame__top-band
  = render 'shared/kronk_wordmark', size: :chrome

  - if user_signed_in?
    %nav.hub-switcher.hub-switcher--top{ 'aria-label' => 'Primary surfaces' }
      .hub-switcher__row{ role: 'tablist' }
        - pillars.each do |pillar|
          %a.hub-switcher__pillar{ href: pillar[:href], role: 'tab', title: pillar[:label], 'aria-selected': pillar[:active].to_s, class: ('hub-switcher__pillar--active' if pillar[:active]) }
            - if pillar[:avatar]
              = image_tag pillar[:avatar], alt: '', class: 'hub-switcher__pillar-icon hub-switcher__pillar-icon--avatar'
            - elsif pillar[:icon]
              = material_symbol(pillar[:icon], class: 'hub-switcher__pillar-icon')
            %span.hub-switcher__label.hub-switcher__label--sr= pillar[:label]
      .hub-switcher__wire{ 'aria-hidden' => 'true' }

-# Phones: the same pillars as the app's bottom tab bar (the top band
-# hides below 630px).
- if user_signed_in?
  %nav.kronk-frame__bottom-band
    %nav.hub-switcher.hub-switcher--bottom{ 'aria-label' => 'Primary surfaces' }
      - pillars.each do |pillar|
        %a.hub-switcher__item{ href: pillar[:href], class: ('hub-switcher__item--active' if pillar[:active]) }
          %span.hub-switcher__icon{ 'aria-hidden' => 'true' }
            - if pillar[:avatar]
              = image_tag pillar[:avatar], alt: '', class: 'hub-switcher__pillar-icon--avatar'
            - elsif pillar[:icon]
              = material_symbol(pillar[:icon])
          %span.hub-switcher__label.hub-switcher__label--sr= pillar[:label]

- if user_signed_in?
  %aside.kronk-frame__right-band
    %nav.korner-sidebar{ 'aria-label' => 'Korners' }
      %nav.korner-sidebar__list
        - korners.each do |k|
          - material = k.icon && k.icon['material']
          %a.korner-sidebar__row{ href: "/hub/#{k.slug}", class: ('korner-sidebar__row--active' if current_slug == k.slug), 'data-name': k.name, 'aria-label': k.name, title: k.name }
            %span.korner-sidebar__glyph{ 'aria-hidden' => 'true' }
              - if material
                = material_symbol(material)
              - else
                = k.name.first.upcase
            %span.korner-sidebar__label= k.name
      %a.korner-sidebar__all{ href: '/hub', title: 'All korners', 'data-name': 'All korners' } ⋯

  .kronk-menu
    %a.kronk-menu__trigger{ href: '/publish', 'aria-label': 'Post', title: 'Post' }
      %span{ 'aria-hidden': 'true' } Ж
