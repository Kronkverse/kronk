- content_for :header_tags do
  %title #{@title} — Kronk

.kronk-org-page
  %nav.kronk-org-page__nav{ 'aria-label': 'Kronk pages' }
    -# Wordmark lives in the fixed top-band via the shared static chrome — no duplicate here.
    %ul.kronk-org-page__nav-list
      - @nav_pages.each do |key|
        %li
          - link_class = ['kronk-org-page__nav-link', ('kronk-org-page__nav-link--active' if key == @page_key)]
          %a{ href: "/kronk/#{key}", class: link_class }
            = key.humanize
    - if user_signed_in?
      %a.kronk-org-page__back-to-app{ href: '/home' }
        &larr; Back to Kronk

  %article.kronk-org-page__body
    %h1= @title
    != @body_html
