!!! 5
%html{ lang: 'en' }
  %head
    %meta{ charset: 'utf-8' }/
    %meta{ name: 'viewport', content: 'width=device-width, initial-scale=1' }/
    %meta{ name: 'robots', content: 'noindex' }/
    %title= "#{@booth_set.title} — The Booth"
    :css
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: #0d0d1a;
        color: #fff;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }

      .player {
        width: 100%;
        max-width: 540px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      .player__cover-wrap {
        position: relative;
        width: 100%;
        aspect-ratio: 1;
        border-radius: 12px;
        overflow: hidden;
        background: #1e1e3a;
        max-height: 260px;
      }

      .player__cover {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .player__cover-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #1e1e3a 0%, #2a1a4a 100%);
      }

      .player__cover-placeholder svg {
        width: 80px;
        height: 80px;
        opacity: 0.3;
      }

      .player__meta {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .player__title {
        font-size: 20px;
        font-weight: 700;
        line-height: 1.2;
        color: #fff;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .player__artist {
        font-size: 15px;
        color: rgba(255,255,255,0.7);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .player__event {
        font-size: 13px;
        color: rgba(255,255,255,0.45);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-top: 2px;
      }

      .player__progress-wrap {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .player__progress {
        width: 100%;
        height: 6px;
        background: rgba(255,255,255,0.15);
        border-radius: 3px;
        cursor: pointer;
        position: relative;
        overflow: visible;
      }

      .player__progress-fill {
        height: 100%;
        background: #7c5cbf;
        border-radius: 3px;
        width: 0%;
        pointer-events: none;
        transition: width 0.25s linear;
      }

      .player__progress:hover .player__progress-fill {
        background: #9b7dda;
      }

      .player__times {
        display: flex;
        justify-content: space-between;
        font-size: 12px;
        color: rgba(255,255,255,0.5);
        font-variant-numeric: tabular-nums;
      }

      .player__controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 28px;
      }

      .player__btn {
        background: none;
        border: none;
        cursor: pointer;
        color: rgba(255,255,255,0.7);
        padding: 8px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.15s, background 0.15s;
      }

      .player__btn:hover {
        color: #fff;
        background: rgba(255,255,255,0.08);
      }

      .player__btn--play {
        width: 60px;
        height: 60px;
        background: #7c5cbf;
        color: #fff;
        border-radius: 50%;
      }

      .player__btn--play:hover {
        background: #9b7dda;
        color: #fff;
      }

      .player__btn svg {
        width: 24px;
        height: 24px;
        fill: currentColor;
      }

      .player__btn--play svg {
        width: 32px;
        height: 32px;
      }

      .player__skip-label {
        font-size: 10px;
        font-weight: 600;
        line-height: 1;
        display: block;
        text-align: center;
        margin-top: 2px;
      }

      .player__footer {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 6px;
        opacity: 0.35;
        font-size: 11px;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

  %body
    .player
      .player__cover-wrap
        - if @booth_set.cover_url
          %img.player__cover{ src: @booth_set.cover_url, alt: '' }/
        - else
          .player__cover-placeholder
            %svg{ viewBox: '0 0 24 24', xmlns: 'http://www.w3.org/2000/svg' }
              %path{ d: 'M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6zm-2 16a2 2 0 1 1 0-4 2 2 0 0 1 0 4z', fill: 'white' }/

      .player__meta
        .player__title= @booth_set.title
        .player__artist= @booth_set.artist_name
        - if @booth_set.event_name.present?
          .player__event= "#{@booth_set.event_name}#{" · #{@booth_set.event_date.strftime('%b %-d, %Y')}" if @booth_set.event_date}"

      .player__progress-wrap
        .player__progress#progress
          .player__progress-fill#progress-fill
        .player__times
          %span#time-current 0:00
          %span#time-total= @booth_set.duration_seconds ? format_duration(@booth_set.duration_seconds) : '—'

      .player__controls
        %button.player__btn#btn-back{ :type => 'button', 'aria-label' => 'Back 30 seconds' }
          %svg{ viewBox: '0 0 24 24', xmlns: 'http://www.w3.org/2000/svg' }
            %path{ d: 'M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z', fill: 'currentColor' }/
          %span.player__skip-label 30s

        %button.player__btn.player__btn--play#btn-play{ :type => 'button', 'aria-label' => 'Play' }
          %svg#icon-play{ viewBox: '0 0 24 24', xmlns: 'http://www.w3.org/2000/svg', style: 'display:block' }
            %path{ d: 'M8 5v14l11-7z', fill: 'currentColor' }/
          %svg#icon-pause{ viewBox: '0 0 24 24', xmlns: 'http://www.w3.org/2000/svg', style: 'display:none' }
            %path{ d: 'M6 19h4V5H6v14zm8-14v14h4V5h-4z', fill: 'currentColor' }/

        %button.player__btn#btn-fwd{ :type => 'button', 'aria-label' => 'Forward 30 seconds' }
          %svg{ viewBox: '0 0 24 24', xmlns: 'http://www.w3.org/2000/svg' }
            %path{ d: 'M18 13c0 3.31-2.69 6-6 6s-6-2.69-6-6 2.69-6 6-6v4l5-5-5-5v4c-4.42 0-8 3.58-8 8s3.58 8 8 8 8-3.58 8-8h-2z', fill: 'currentColor' }/
          %span.player__skip-label 30s

      .player__footer
        The Booth · Kronk

    %audio#audio{ src: @booth_set.audio_url, preload: 'metadata' }

    :javascript
      const audio = document.getElementById('audio');
      const btnPlay = document.getElementById('btn-play');
      const iconPlay = document.getElementById('icon-play');
      const iconPause = document.getElementById('icon-pause');
      const progressBar = document.getElementById('progress');
      const progressFill = document.getElementById('progress-fill');
      const timeCurrent = document.getElementById('time-current');
      const timeTotal = document.getElementById('time-total');

      function fmt(secs) {
        const s = Math.floor(secs);
        const m = Math.floor(s / 60);
        const sec = s % 60;
        return m + ':' + String(sec).padStart(2, '0');
      }

      function updateProgress() {
        if (!audio.duration) return;
        const pct = (audio.currentTime / audio.duration) * 100;
        progressFill.style.width = pct + '%';
        timeCurrent.textContent = fmt(audio.currentTime);
        if (!isNaN(audio.duration)) timeTotal.textContent = fmt(audio.duration);
      }

      audio.addEventListener('timeupdate', updateProgress);
      audio.addEventListener('loadedmetadata', updateProgress);

      audio.addEventListener('play', () => {
        iconPlay.style.display = 'none';
        iconPause.style.display = 'block';
      });

      audio.addEventListener('pause', () => {
        iconPlay.style.display = 'block';
        iconPause.style.display = 'none';
      });

      btnPlay.addEventListener('click', () => {
        if (audio.paused) {
          audio.play();
          fetch('/api/v1/booth_sets/#{@booth_set.id}/play', { method: 'POST' }).catch(() => {});
        } else {
          audio.pause();
        }
      });

      document.getElementById('btn-back').addEventListener('click', () => {
        audio.currentTime = Math.max(0, audio.currentTime - 30);
      });

      document.getElementById('btn-fwd').addEventListener('click', () => {
        audio.currentTime = Math.min(audio.duration || Infinity, audio.currentTime + 30);
      });

      progressBar.addEventListener('click', (e) => {
        if (!audio.duration) return;
        const rect = progressBar.getBoundingClientRect();
        const pct = (e.clientX - rect.left) / rect.width;
        audio.currentTime = pct * audio.duration;
      });
