- content_for :header_tags do
  = vite_typescript_tag 'public.tsx', crossorigin: 'anonymous'

- content_for :content do
  .container-alt
    -# Wordmark comes from the static Kronk chrome top-band
    -# (shared/_kronk_static_chrome.html.haml), rendered by the
    -# application layout wrapper below. Rendering another one here
    -# doubled the logo on every auth page — one at the top of the
    -# chrome, one above the form. Retired 2026-07-31.
    .form-container
      = render 'flashes'

      = yield

= render template: 'layouts/application'
