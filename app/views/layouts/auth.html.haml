- content_for :header_tags do
  = vite_typescript_tag 'public.tsx', crossorigin: 'anonymous'

- content_for :content do
  -# Wordmark comes from `_kronk_static_chrome` (rendered by the
  -# application layout wrapper below). The old `.container-alt >
  -# .form-container` wrapping was upstream Mastodon's centred-form
  -# pattern; retired 2026-08-04 in favour of the
  -# `.kronk-auth-shell` treatment declared in `styles/kronk/_form.scss`.
  -# Each Devise view renders its own shell via
  -# `auth/shared/_kronk_auth_form` and handles its own centring.
  = render 'flashes'

  = yield

= render template: 'layouts/application'
